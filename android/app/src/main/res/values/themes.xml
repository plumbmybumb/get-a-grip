<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only sets the window up: no action bar,
         edge-to-edge (enableEdgeToEdge() finishes it), the slate field behind the
         splash so the first frame is already the app's ground. -->
    <style name="Theme.GetAGrip" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/slate_field</item>
        <item name="android:windowSplashScreenBackground">@color/slate_field</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
