<?xml version="1.0" encoding="utf-8"?>
<!-- System backup and device transfer include the Room database and DataStore.
     Availability and restoration depend on the device/provider and user settings.
     This is not live sync. The export cache is outside the included domains. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
