      "canonical": "{\"handMode\":\"alternateEachRep\",\"holdSeconds\":10,\"leadInSeconds\":5,\"name\":\"Broken sets\",\"pausesOutsideTargetBand\":true,\"restSeconds\":20,\"setBreakSeconds\":60,\"sets\":[],\"thresholdKg\":2,\"waitForReleaseBeforeRest\":true}"
    },
    {
      "name": "a full routine with one set",
      "input": "{\"name\":\"Max day\",\"sets\":[{\"id\":\"8B2C4E8A-0000-4000-8000-000000000009\",\"grip\":{\"edgeMM\":20,\"fingers\":\"IMRL\",\"position\":\"halfCrimp\"},\"repsPerSide\":4,\"targetLoPercent\":0.8,\"targetHiPercent\":0.9}],\"handMode\":\"alternateEachSet\",\"holdSeconds\":3,\"restSeconds\":5,\"setBreakSeconds\":120,\"leadInSeconds\":5,\"thresholdKg\":2,\"waitForReleaseBeforeRest\":false,\"pausesOutsideTargetBand\":false}",
      "canonical": "{\"handMode\":\"alternateEachSet\",\"holdSeconds\":3,\"leadInSeconds\":5,\"name\":\"Max day\",\"pausesOutsideTargetBand\":false,\"restSeconds\":5,\"setBreakSeconds\":120,\"sets\":[{\"grip\":{\"edgeMM\":20,\"fingers\":\"IMRL\",\"position\":\"halfCrimp\"},\"id\":\"8B2C4E8A-0000-4000-8000-000000000009\",\"note\":\"\",\"repsPerSide\":4,\"targetHiPercent\":0.9,\"targetLoPercent\":0.8}],\"thresholdKg\":2,\"waitForReleaseBeforeRest\":false}"
    },
    {
