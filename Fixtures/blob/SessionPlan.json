      "canonical": "{\"handMode\":\"alternateEachRep\",\"holdSeconds\":10,\"leadInSeconds\":5,\"name\":\"Daily no-hangs\",\"pausesOutsideTargetBand\":true,\"restSeconds\":20,\"setBreakSeconds\":900,\"sets\":[],\"thresholdKg\":30,\"waitForReleaseBeforeRest\":true}"
