      "key": "1|IMRL|halfCrimp"
    },
    {
      "name": "edge clamps down to the 100 mm ceiling",
      "input": "{\"edgeMM\":5000,\"fingers\":\"IMRL\",\"position\":\"halfCrimp\"}",
