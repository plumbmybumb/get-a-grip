      "input": "{\"edgeMM\":20,\"fingers\":\"IMRL\",\"position\":\"halfCrimp\"}",
      "canonical": "{\"edgeMM\":20,\"fingers\":\"IMRL\",\"position\":\"halfCrimp\"}",
      "key": "20|IMRL|halfCrimp"
    },
    {
      "name": "front two, full crimp",
      "input": "{\"edgeMM\":20,\"fingers\":\"IM\",\"position\":\"fullCrimp\"}",
      "canonical": "{\"edgeMM\":20,\"fingers\":\"IM\",\"position\":\"fullCrimp\"}",
      "key": "20|IM|fullCrimp"
    },
    {
      "name": "a position raw this build has never heard of survives untouched",
      "input": "{\"edgeMM\":20,\"fingers\":\"IM\",\"position\":\"sloper\"}",
      "canonical": "{\"edgeMM\":20,\"fingers\":\"IM\",\"position\":\"sloper\"}",
      "key": "20|IM|sloper"
    },
    {
