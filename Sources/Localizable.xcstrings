      }
    },
    "Too many gaps in the gauge's readings to give a result. Keep the phone closer next time." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de trous dans les mesures du capteur pour donner un résultat. Garde le téléphone plus près la prochaine fois."
          }
        }
      }
    },
    "No pulls recorded. Tare the gauge and pull through it." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun tirage enregistré. Tare le capteur et tire à travers lui."
          }
        }
      }
    },
    "Stopped before pull 16, so there's no result. Rest at least 30 minutes before retesting." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrêté avant le tirage 16, donc pas de résultat. Repose-toi au moins 30 minutes avant de refaire le test."
          }
        }
      }
    },
    "The gauge disconnected before pull 16, so there's no result. Rest at least 30 minutes before retesting." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le capteur s'est déconnecté avant le tirage 16, donc pas de résultat. Repose-toi au moins 30 minutes avant de refaire le test."
          }
        }
      }
    },
    "You left the app before pull 16, so there's no result. Rest at least 30 minutes before retesting." : {
