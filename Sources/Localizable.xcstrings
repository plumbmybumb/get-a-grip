          }
        }
      }
    },
    "Routine reminders are scheduled on each device separately. A session logged on any of them silences the day’s reminders everywhere once it syncs." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels de routine sont programmés sur chaque appareil séparément. Une séance enregistrée sur l’un d’eux coupe les rappels du jour partout, une fois synchronisée."
          }
        }
      }
    },
    "Remind on this iPad" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappels sur cet iPad"
          }
        }
      }
    },
    "Remind on this iPhone" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rappels sur cet iPhone"
          }
        }
      }
    },
    "Used to show critical force as a share of body weight. Each test keeps the weight it was taken at, so changing this never alters an old result." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sert à afficher la force critique en proportion du poids du corps. Chaque test garde le poids du moment, donc le modifier ne change jamais un ancien résultat."
          }
        }
      }
    },
