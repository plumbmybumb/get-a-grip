        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes chiffres"
          }
        }
      }
    },
    "Your percent targets follow whatever you save here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes cibles en pourcentage suivent ce que tu enregistres ici."
          }
