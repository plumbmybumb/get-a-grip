    },
    "Zero the gauge." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre le capteur à zéro."
          }
        }
      }
    },
    "A max records your hardest measured pull on a grip." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un max correspond à votre traction mesurée la plus forte sur une prise."
          }
        }
      }
    },
    "A number you entered. Check its value and units before using it for targets." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une valeur saisie par vous. Vérifiez sa valeur et son unité avant de l’utiliser pour vos cibles."
          }
        }
      }
    },
    "Build force gradually and stop if it hurts. This measures a peak, not a safe training limit." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Augmentez la force progressivement et arrêtez en cas de douleur. Ce test mesure un pic, pas une limite d’entraînement sans risque."
          }
        }
      }
    },
    "Keep the gauge unloaded while Get a Grip connects and tares it. If the gauge is asleep, the app waits." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le capteur déchargé pendant la connexion et la tare. Si le capteur est en veille, l’application attend."
          }
        }
      }
    },
    "Keep the gauge unloaded while it connects and tares." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez le capteur déchargé pendant la connexion et la tare."
          }
        }
      }
    },
    "Let go when you are ready to finish." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relâchez lorsque vous souhaitez terminer."
          }
        }
      }
    },
    "Measure a peak on your gauge, or record a previous measurement. You can update it whenever you need." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mesurez un pic avec votre capteur ou saisissez une mesure précédente. Vous pouvez le mettre à jour à tout moment."
          }
        }
      }
    },
    "No live reading" : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune mesure en direct"
