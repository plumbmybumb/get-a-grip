    "This build can't reach its shared storage, so routines saved earlier may not appear here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version n'atteint pas son stockage partagé, les routines enregistrées avant peuvent donc ne pas apparaître ici."
