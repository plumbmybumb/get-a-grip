    "You can connect your gauge later." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu peux connecter ton capteur plus tard."
          }
        }
      }
    },
    "Your ceiling, per grip" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton plafond, par prise"
          }
        }
      }
    },
    "Your current max on this grip%@ is %@ kg, recorded %@. Saving adds a new one and keeps the old as history." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton max actuel sur cette prise%@ est de %@ kg, enregistré %@. Enregistrer en ajoute un nouveau et garde l'ancien dans l'historique."
          }
        }
      }
    },
    "your fingers felt %@" : {
