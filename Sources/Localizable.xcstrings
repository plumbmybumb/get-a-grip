      }
    },
    "Your routine" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ta routine"
          }
        }
      }
    },
    "YOUR ROUTINE" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "TA ROUTINE"
          }
        }
      }
    },
    "Your routines and sessions stay on this device and in your private iCloud. Nobody else can read them — not even us." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes routines et tes séances restent sur cet appareil et dans ton iCloud privé. Personne d'autre ne peut les lire — nous non plus."
          }
        }
      }
    },
    "Your sessions will show up here." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes séances apparaîtront ici."
          }
        }
      }
    },
    "Your sets, in order" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes séries, dans l'ordre"
          }
        }
      }
    },
    "Your working max is the newest test, best is your record. Percentage targets follow the newest number — up or down." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ton max de travail est le test le plus récent, le record est ton meilleur. Les cibles en pourcentage suivent le chiffre le plus récent — à la hausse comme à la baisse."
          }
        }
      }
    },
    "Zero it" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre à zéro"
          }
        }
      }
    },
    "Zero the gauge" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre le capteur à zéro"
          }
        }
