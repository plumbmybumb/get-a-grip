        }
      }
    },
    "No pull was recorded. You can close this or try again." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune traction enregistrée. Vous pouvez fermer cet écran ou réessayer."
          }
        }
      }
    },
    "Percentage targets use the max saved for that grip and hand. A saved max is a reference, not a safe-load limit." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cibles en pourcentage utilisent le max enregistré pour cette prise et cette main. Un max est une référence, pas une limite de charge sans risque."
          }
        }
      }
    },
    "Percentage targets use your saved maxes. These may no longer reflect your current strength." : {
      "extractionState" : "manual",
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cibles en pourcentage utilisent vos max enregistrés, qui peuvent ne plus refléter votre force actuelle."
          }
        }
