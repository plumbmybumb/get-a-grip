    "Average per pull" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Moyenne par tirage"
          }
        }
      }
    },
    "%lld of %lld pulls done" : {
      "localizations" : {
        "fr" : {
