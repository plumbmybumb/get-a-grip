      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Get a Grip saves your shareable images to your photo library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Get a Grip enregistre tes images à partager dans ta photothèque."
          }
        }
